# --- Infisical bootstrap (the ONLY raw secrets allowed in Railway env) ---------------------------
# Machine identity for this app (secrets:read). Never the mcp-reader identity.
INFISICAL_RESOLVER_ENABLED=true
INFISICAL_APP_CLIENT_ID=
INFISICAL_APP_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
# INFISICAL_SITE_URL=https://app.infisical.com

# --- Secrets: handles only, resolved at boot by secrets.js ------------------------------------
# House layout: shared eiaaw-all-projects workspace, one environment per stage, flat at the root.
# Confirm each exact secret name in Infisical before switching a variable to its handle.
# RESEND_API_KEY must be EIAAW's own Resend account (eiaawsolutions.com verified). Other EIAAW projects
# reference it as either .../prod/RESEND_API or .../prod/RESEND_API_KEY; use whichever is EIAAW's.
RESEND_API_KEY=secret://eiaaw-all-projects/prod/RESEND_API_KEY
ANTHROPIC_API_KEY=secret://eiaaw-all-projects/prod/ANTHROPIC_API_KEY
# NOTIFY_WEBHOOK_SECRET=secret://eiaaw-all-projects/prod/NOTIFY_WEBHOOK_SECRET

# --- Plain config (not secret) -----------------------------------------------------------------
DATABASE_URL=${{Postgres.DATABASE_URL}}
PUBLIC_URL=https://rent.eiaawsolutions.com
# AI_MODEL=claude-haiku-4-5
# EMAIL_FROM=Rhythm Avenue <rent@eiaawsolutions.com>   # needs the domain verified in Resend
# NOTIFY_EMAIL=owner@example.com                       # extra recipients; eiaawsolutions@gmail.com always gets every enquiry
# NOTIFY_WEBHOOK_URL=
